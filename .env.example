# Только сервер: значения хранятся в секретных переменных Timeweb или .env.local.
# Никогда не добавляйте токен в VITE_*.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
# Точный публичный адрес сайта без пути, например https://example.ru.
APP_ORIGIN=http://localhost:5173
PORT=3000
# 1 — только если сервер доступен исключительно через reverse proxy Timeweb.
TRUST_PROXY=0

# Путь публикации: / для Timeweb, /beauty-dynastya-2.0/ для GitHub Pages.
VITE_BASE_PATH=/
