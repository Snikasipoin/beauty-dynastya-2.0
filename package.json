{
  "name": "beauty-dynastya",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src server scripts/telegram-chat.ts tests/server vite.config.ts",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "start": "node --env-file-if-exists=.env.local server/index.ts",
    "dev:server": "node --env-file-if-exists=.env.local --watch server/index.ts",
    "test:server": "node --test tests/server/*.test.ts",
    "telegram:chat": "node --env-file-if-exists=.env.local scripts/telegram-chat.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/oswald": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.1",
    "i18next": "^26.7.1",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
